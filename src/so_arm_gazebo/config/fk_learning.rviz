Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /FK markers1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Table-height grid
      Enabled: true
      Value: true
      Alpha: 0.3
      Cell Size: 0.05
      Color: 145; 153; 165
      Line Style:
        Line Width: 0.001
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0.60
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: SO100 measured state
      Enabled: true
      Value: true
      Alpha: 0.85
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: FK markers
      Enabled: true
      Value: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fk/markers
    - Class: rviz_default_plugins/TF
      Name: TF frames (optional)
      Enabled: false
      Value: false
      Frame Timeout: 15
      Marker Scale: 0.04
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 35; 41; 50
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 214; 100
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.90
      Focal Point:
        X: 0
        Y: -0.10
        Z: 0.75
      Near Clip Distance: 0.005
      Pitch: 0.45
      Yaw: -1.05
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1150
  Hide Left Dock: false
  Hide Right Dock: false
  X: 0
  Y: 0
