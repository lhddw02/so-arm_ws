<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so_arm100">
  <xacro:arg name="controller_config" default="$(find so_arm_gazebo)/config/controllers.yaml"/>

  <!-- Source: Simulation/SO100/so100.urdf. Meshes are already in metres.
       Original joint axes, origins, limits, visuals, and inertias are retained.
       A fixed world mount locates the base on the 0.60 m tabletop. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0.60" rpy="0 0 0"/>
  </joint>

  
  <!-- Materials -->
  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Link base -->
  <link name="base">
    <inertial>
      <!-- Approximate inertial values -->
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Base.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Base_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Base.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link shoulder -->
  <link name="shoulder">
    <inertial>
      <mass value="0.119226"/>
      <origin xyz="-9.07886e-05 0.0590972 0.031089" rpy="0 0 0"/>
      <inertia ixx="5.94278e-05" ixy="0" ixz="0" iyy="5.89975e-05" iyz="0" izz="3.13712e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Rotation_Pitch.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Rotation_Pitch_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Rotation_Pitch.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link upper_arm -->
  <link name="upper_arm">
    <inertial>
      <mass value="0.162409"/>
      <origin xyz="-1.72052e-05 0.0701802 0.00310545" rpy="0 0 0"/>
      <inertia ixx="0.000213312" ixy="0" ixz="0" iyy="0.000167164" iyz="0" izz="7.01522e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Upper_Arm.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Upper_Arm_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Upper_Arm.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link lower_arm -->
  <link name="lower_arm">
    <inertial>
      <mass value="0.147968"/>
      <origin xyz="-0.00339604 0.00137796 0.0768007" rpy="0 0 0"/>
      <inertia ixx="0.000138803" ixy="0" ixz="0" iyy="0.000107748" iyz="0" izz="4.84242e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Lower_Arm.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Lower_Arm_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Lower_Arm.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link wrist -->
  <link name="wrist">
    <inertial>
      <mass value="0.0661321"/>
      <origin xyz="-0.00852653 -0.0352279 -2.34622e-05" rpy="0 0 0"/>
      <inertia ixx="3.45403e-05" ixy="0" ixz="0" iyy="2.39041e-05" iyz="0" izz="1.94704e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Wrist_Pitch_Roll.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Wrist_Pitch_Roll_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Wrist_Pitch_Roll.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper jaw visuals are contact-free in this assisted grasp demo.
       The arm collision meshes remain active; the grasp plugin carries the cube.
       The link has a distinct name from the gripper joint for SDF frame semantics. -->
  <!-- The source uses 'gripper' for both a link and its jaw joint. SDF frame
       names must be unique: rename only the link, keeping joint/controller APIs. -->
  <link name="gripper_link">
    <inertial>
      <mass value="0.0929859"/>
      <origin xyz="0.00552377 -0.0280167 0.000483583" rpy="0 0 0"/>
      <inertia ixx="5.03136e-05" ixy="0" ixz="0" iyy="4.64098e-05" iyz="0" izz="2.72961e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Fixed_Jaw.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Fixed_Jaw_Motor.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
  </link>

  <!-- Link jaw -->
  <link name="jaw">
    <inertial>
      <mass value="0.0202444"/>
      <origin xyz="-0.00161745 -0.0303473 0.000449646" rpy="0 0 0"/>
      <inertia ixx="1.11265e-05" ixy="0" ixz="0" iyy="8.99651e-06" iyz="0" izz="2.99548e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_gazebo/meshes/Moving_Jaw.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <!-- Visual-only moving jaw for assisted grasping. It has mass/inertia and
         an actuated joint, but cannot nudge the cube before attachment. -->
  </link>


  <!-- Joint from base to shoulder -->
  <joint name="shoulder_pan" type="revolute">
    <parent link="base"/>
    <child link="shoulder"/>
    <origin xyz="0 -0.0452 0.0165" rpy="1.57079 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="-2" upper="2" effort="35" velocity="1"/>
  </joint>


  <!-- Joint from shoulder to upper_arm -->
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <origin xyz="0 0.1025 0.0306" rpy="-1.8 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="0" upper="3.5" effort="35" velocity="1"/>
  </joint>


  <!-- Joint from upper_arm to lower_arm -->
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <origin xyz="0 0.11257 0.028" rpy="1.57079 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="-3.14158" upper="0" effort="35" velocity="1"/>
  </joint>


  <!-- Joint from lower_arm to wrist -->
  <joint name="wrist_flex" type="revolute">
    <parent link="lower_arm"/>
    <child link="wrist"/>
    <origin xyz="0 0.0052 0.1349" rpy="-1 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="-2.5" upper="1.2" effort="35" velocity="1"/>
  </joint>


  <!-- Joint from wrist to gripper -->
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist"/>
    <child link="gripper_link"/>
    <origin xyz="0 -0.0601 0" rpy="0 1.57079 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="-3.14158" upper="3.14158" effort="35" velocity="1"/>
  </joint>


  <!-- Joint from gripper to jaw -->
  <joint name="gripper" type="revolute">
    <parent link="gripper_link"/>
    <child link="jaw"/>
    <origin xyz="-0.0202 -0.0244 0" rpy="0 3.14158 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.02"/>
    <limit lower="-0.2" upper="2.0" effort="35" velocity="1"/>
  </joint>



  <!-- TCP lies between the distal jaws. Its axes match the gripper frame;
       local -Y is the grasp approach direction. Positive gripper angle opens. -->
  <link name="tool0">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="gripper_to_tool0" type="fixed">
    <parent link="gripper_link"/>
    <child link="tool0"/>
    <origin xyz="0 -0.100 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="gripper_to_tool0">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="jaw">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="gripper_link">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <!-- Gazebo Classic does not use URDF material colors for STL visuals. -->
  <gazebo reference="base"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="shoulder"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="upper_arm"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="lower_arm"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="wrist"><material>Gazebo/Yellow</material></gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="shoulder_pan">
      <command_interface name="position"><param name="min">-2</param><param name="max">2</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift">
      <command_interface name="position"><param name="min">0</param><param name="max">3.5</param></command_interface>
      <state_interface name="position"><param name="initial_value">1.6569670531</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_flex">
      <command_interface name="position"><param name="min">-3.14158</param><param name="max">0</param></command_interface>
      <state_interface name="position"><param name="initial_value">-1.5806712649</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_flex">
      <command_interface name="position"><param name="min">-2.5</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"><param name="initial_value">1.1529205386</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_roll">
      <command_interface name="position"><param name="min">-3.14158</param><param name="max">3.14158</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper">
      <command_interface name="position"><param name="min">-0.2</param><param name="max">2.0</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(arg controller_config)</parameters>
    </plugin>
    <plugin name="so_arm_grasp" filename="libso_arm_grasp_plugin.so">
      <ros><namespace>/grasp</namespace></ros>
      <object_model>pick_cube</object_model>
      <object_link>link</object_link>
      <gripper_link>gripper_link</gripper_link>
      <gripper_joint>gripper</gripper_joint>
      <tool_offset>0 -0.100 0</tool_offset>
      <max_attach_distance>0.018</max_attach_distance>
      <closed_position>0.0</closed_position>
      <closed_tolerance>0.08</closed_tolerance>
    </plugin>
  </gazebo>

</robot>
 
