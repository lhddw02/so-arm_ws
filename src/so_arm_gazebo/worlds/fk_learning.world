<?xml version="1.0"?>
<sdf version="1.6">
  <world name="so_arm_fk_learning">
    <!-- This is an ideal kinematics lab: no gravity or world contact forces. -->
    <gravity>0 0 0</gravity>
    <physics name="fk_lab_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver></ode>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="fk_learning_camera">
        <pose>0.70 -0.90 1.15 0 0.40 2.30</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -1</direction>
    </light>
    <model name="lab_ground">
      <static>true</static>
      <link name="ground">
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.48 0.5 0.54 1</ambient><diffuse>0.5 0.52 0.56 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="lab_table">
      <static>true</static>
      <link name="table">
        <!-- Visual reference only: arbitrary URDF poses may pass through it. -->
        <visual name="tabletop_visual">
          <pose>0 -0.05 0.58 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
          <material><ambient>0.64 0.53 0.38 1</ambient><diffuse>0.76 0.64 0.47 1</diffuse></material>
        </visual>
        <visual name="leg_front_left">
          <pose>0.44 -0.39 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_front_right">
          <pose>-0.44 -0.39 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_back_left">
          <pose>0.44 0.29 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_back_right">
          <pose>-0.44 0.29 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>30</update_rate>
    </plugin>
  </world>
</sdf>
