<?xml version="1.0"?>
<sdf version="1.6">
  <world name="so_arm_pick_place">
    <gravity>0 0 -9.81</gravity>
    <physics name="tabletop_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.82 0.87 0.93 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="tabletop_camera">
        <pose>0.65 -0.80 1.05 0 0.45 2.30</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Everything is defined locally; no downloads from model:// repositories. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="work_table">
      <static>true</static>
      <link name="table">
        <!-- Upper face is exactly world z=0.60 m. -->
        <collision name="tabletop_collision">
          <pose>0 -0.05 0.58 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="tabletop_visual">
          <pose>0 -0.05 0.58 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.04</size></box></geometry>
          <material><ambient>0.62 0.45 0.29 1</ambient><diffuse>0.75 0.57 0.38 1</diffuse></material>
        </visual>
        <visual name="leg_front_left">
          <pose>0.44 -0.39 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_front_right">
          <pose>-0.44 -0.39 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_back_left">
          <pose>0.44 0.29 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_back_right">
          <pose>-0.44 0.29 0.28 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.56</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_marker">
      <static>true</static>
      <pose>0.11 -0.18 0.6005 0 0 0</pose>
      <link name="marker">
        <!-- Visual only: it cannot catch or collide with the cube. -->
        <visual name="target_visual">
          <geometry><box><size>0.05 0.05 0.0005</size></box></geometry>
          <material><ambient>0.1 0.65 0.22 1</ambient><diffuse>0.1 0.85 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pick_cube">
      <pose>0 -0.22 0.61 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>0.000001333333</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001333333</iyy><iyz>0</iyz><izz>0.000001333333</izz></inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact><ode><kp>100000</kp><kd>1</kd><max_vel>0.05</max_vel><min_depth>0.0001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <material><ambient>1.0 0.25 0.03 1</ambient><diffuse>1.0 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>30</update_rate>
    </plugin>
  </world>
</sdf>
